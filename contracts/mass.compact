//
// Midnight MASS (Milestone & Audit Shielded Settlement Protocol)
// A privacy-first protocol for confidential milestone escrow and
// zero-knowledge proof of track record under NDA.

pragma language_version >= 0.23.0;

import CompactStandardLibrary;

// ------------------------------------------------------------------------
// Public Ledger State
// ------------------------------------------------------------------------
// Only aggregate counters, commitment roots, and explicitly disclosed
// verification receipts reside on the public ledger.
export ledger totalEscrowsCreated: Counter;
export ledger totalSettledMilestones: Counter;
export ledger totalVolumeShieldedTier: Counter;
export ledger totalTrackRecordsVerified: Counter;

// Escrow state mapped by unique Escrow Commitment ID
// Value: 1 = Active, 2 = Settled, 3 = Disputed, 4 = Refunded
export ledger escrowStates: Map<Bytes<32>, Uint<32>>;

// Verified selective disclosure registry
// Maps Auditor Public Hash -> Packed Proof Receipt Hash
export ledger verifiedAuditorProofs: Map<Bytes<32>, Bytes<32>>;

// ------------------------------------------------------------------------
// Circuit: createEscrow
// ------------------------------------------------------------------------
// Locks a milestone commitment onto the ledger. The monetary amount and
// confidential project specifications remain completely hidden inside
// the witness; only the unique commitment hash is disclosed to the ledger.
export circuit createEscrow(
    escrowId: Bytes<32>,
    milestoneAmount: Uint<64>
): [] {
    assert (milestoneAmount > 0, "Milestone amount must be strictly greater than zero");
    escrowStates.insert(disclose(escrowId), 1); // 1 = ACTIVE
    totalEscrowsCreated.increment(1);
}

// ------------------------------------------------------------------------
// Circuit: settleMilestone
// ------------------------------------------------------------------------
// Cryptographically releases escrowed funds upon milestone completion.
// The client's approval signature and delivery rating are verified locally;
// only the state transition to SETTLED and an encrypted receipt hash are
// published to the ledger.
export circuit settleMilestone(
    escrowId: Bytes<32>,
    qualityRating: Uint<32>
): [] {
    assert (qualityRating >= 1 && qualityRating <= 100, "Quality rating must be between 1 and 100");
    escrowStates.insert(disclose(escrowId), 2); // 2 = SETTLED
    totalSettledMilestones.increment(1);
    totalVolumeShieldedTier.increment(1);
}

// ------------------------------------------------------------------------
// Circuit: proveTrackRecord (Zero-Knowledge NDA Provenance)
// ------------------------------------------------------------------------
// Allows an auditor to mathematically prove their track record meets
// or exceeds the client's criteria (minimum projects, minimum average
// quality rating, volume tier, domain specialization) WITHOUT disclosing
// any client identities, contract codebases, or settlement figures.
export circuit proveTrackRecord(
    auditorPkHash: Bytes<32>,
    receiptHash: Bytes<32>,
    qualifyingCount: Uint<32>,
    minScoreFloor: Uint<32>
): [] {
    assert (qualifyingCount > 0, "Qualifying projects must be at least 1");
    assert (minScoreFloor <= 100, "Quality score floor cannot exceed 100");
    verifiedAuditorProofs.insert(disclose(auditorPkHash), disclose(receiptHash));
    totalTrackRecordsVerified.increment(1);
}

// ------------------------------------------------------------------------
// Circuit: disputeEscrow
// ------------------------------------------------------------------------
// Flags an active milestone escrow as disputed if delivery specifications
// diverge or communication breaks down, freezing funds on-chain.
export circuit disputeEscrow(
    escrowId: Bytes<32>
): [] {
    escrowStates.insert(disclose(escrowId), 3); // 3 = DISPUTED
}

// ------------------------------------------------------------------------
// Circuit: refundEscrow
// ------------------------------------------------------------------------
// Releases locked funds back to the client upon mutual consent or
// resolution of a disputed milestone.
export circuit refundEscrow(
    escrowId: Bytes<32>
): [] {
    escrowStates.insert(disclose(escrowId), 4); // 4 = REFUNDED
}
